if(NOT DEFINED OUTPUT OR NOT DEFINED PREF_PATH)
  message(FATAL_ERROR "OUTPUT and host PREF_PATH are required")
endif()
get_filename_component(CONFIG_DIR "${OUTPUT}" DIRECTORY)
if(NOT DEFINED SCREEN_FILTER)
  set(SCREEN_FILTER Nearest)
endif()
if(NOT SCREEN_FILTER STREQUAL "Nearest" AND NOT SCREEN_FILTER STREQUAL "Bilinear")
  message(FATAL_ERROR "SCREEN_FILTER must be Nearest or Bilinear")
endif()
set(EMULATOR_HOST_VSYNC true)
if(DEFINED HOST_VSYNC AND NOT HOST_VSYNC)
  set(EMULATOR_HOST_VSYNC false)
endif()
set(DISABLE_SURFACE_SYNC true)
if(SURFACE_SYNC)
  set(DISABLE_SURFACE_SYNC false)
endif()
file(MAKE_DIRECTORY "${CONFIG_DIR}/storage")
configure_file("${CMAKE_CURRENT_LIST_DIR}/vita3k.yml.in" "${OUTPUT}" @ONLY)
