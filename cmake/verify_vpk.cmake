cmake_minimum_required(VERSION 3.16)
if(NOT EXISTS "${VPK}" OR NOT EXISTS "${MANIFEST}")
  message(FATAL_ERROR "Provide existing -DVPK=... and -DMANIFEST=...")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${VPK}"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE CONTENTS ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0)
  message(FATAL_ERROR "Cannot read VPK: ${ERROR}")
endif()
string(REPLACE "\n" ";" CONTENTS "${CONTENTS}")
file(STRINGS "${MANIFEST}" ASSETS)
set(REQUIRED eboot.bin sce_sys/param.sfo assets/manifest.txt licenses/asciicker.txt licenses/quickjs.txt)
foreach(ASSET IN LISTS ASSETS)
  list(APPEND REQUIRED "assets/${ASSET}")
endforeach()
foreach(ENTRY IN LISTS REQUIRED)
  if(NOT ENTRY IN_LIST CONTENTS)
    message(FATAL_ERROR "Missing VPK entry: ${ENTRY}")
  endif()
endforeach()
list(LENGTH REQUIRED COUNT)
message(STATUS "VPK_OK: ${COUNT} required entries present")
