void main(float3 position, float4 color, float4 surface,
          uniform float4x4 mvp, uniform float4x4 normals, uniform float4 plane, uniform float4 light,
          out float4 clip : POSITION, out float4 tint : COLOR,
          out float4 info : TEXCOORD0, out float height : TEXCOORD1) {
    clip = mul(float4(position, 1.0), mvp);
    clip.z = (clip.z + clip.w) * 0.5;
    tint = color;
    info = surface;
    height = surface.w > 1.5 && surface.w < 2.5 ? 1.0 : dot(float4(position, 1.0), plane);
    if (surface.w > 0.5 && surface.w < 1.5)
        info.z = clamp(dot(normalize(color.xyz * 2.0 - 1.0), light.xyz / max(length(light.xyz),0.0001)) * (1.0-light.w) + light.w, 0.0, 1.0);
    if (surface.w > 2.5) {
        float3 normal = normalize(mul(float4(surface.xyz, 0.0), normals).xyz);
        float diffuse = dot(normal, light.xyz / max(length(light.xyz), 0.0001));
        tint.rgb *= clamp(diffuse*(1.0-0.5*light.w)+0.5*light.w+0.5, 0.0, 1.0);
    }
}
