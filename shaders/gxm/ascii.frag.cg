uniform sampler2D scene : register(s0);
uniform sampler2D materials : register(s1);
uniform sampler2D font : register(s2);
uniform sampler2D overlay : register(s3);
uniform sampler2D underlay : register(s4);
uniform sampler2D reflection : register(s5);
uniform sampler2D styles : register(s6);
uniform float clock;
#include "../common/ascii.cg"
float4 main(float4 tint : COLOR, uniform float4 layout) : COLOR {
    return resolve_ascii(tint.xy, layout);
}
